# Cadena de conexión pooled de Neon
DATABASE_URL=
# Dominio público (en local se deduce de la petición). Ej: https://mi-proyecto.vercel.app
BASE_URL=
# Cadena aleatoria larga para firmar la cookie de sesión
JWT_SECRET=
# Solo para el script npm run seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Opcionales (valores por defecto entre paréntesis)
# Intentos fallidos de login antes de bloquear 15 minutos (5)
LOGIN_MAX_ATTEMPTS=
# Minutos de la ventana de bloqueo de login (15)
LOGIN_WINDOW_MINUTES=
# Creaciones de URL por minuto e IP sin clave válida (30)
URL_RATE_LIMIT_PER_MINUTE=
# Creaciones de URL por minuto y API key válida (120)
API_KEY_RATE_LIMIT_PER_MINUTE=
